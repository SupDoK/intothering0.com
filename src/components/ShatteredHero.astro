<section class="hero" id="hero">
  <!--
    Hand-authored SVG: 22 glass shards radiating from an explosion center at ~(470, 188).
    data-depth: 1 = background (slow), 4 = foreground (fast).
    Fills are pale blue-white at varied opacities; strokes alternate between thin red
    highlights and icy edge glints to simulate light catching the fracture lines.
  -->
  <svg
    class="hero-svg"
    viewBox="0 0 1000 380"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <!-- Radial glow behind the shatter point -->
      <radialGradient id="shatterGlow" cx="47%" cy="49%" r="42%" gradientUnits="objectBoundingBox">
        <stop offset="0%"   stop-color="#c41e3a" stop-opacity="0.22"/>
        <stop offset="45%"  stop-color="#7a0010" stop-opacity="0.07"/>
        <stop offset="100%" stop-color="#0a0a0a" stop-opacity="0"/>
      </radialGradient>
      <!-- Subtle light gradient for shard fills -->
      <linearGradient id="shardFill" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%"   stop-color="#c8dff0" stop-opacity="1"/>
        <stop offset="100%" stop-color="#8fb8d8" stop-opacity="1"/>
      </linearGradient>
    </defs>

    <!-- Background glow -->
    <rect width="1000" height="380" fill="url(#shatterGlow)"/>

    <!-- ── BACKGROUND SHARDS (depth 1–2, large, muted) ───────────────── -->

    <!-- Shard 1: large upper-left -->
    <polygon
      data-depth="1"
      points="28,8 298,6 450,150 270,210 52,165"
      fill="url(#shardFill)" fill-opacity="0.06"
      stroke="#2a1416" stroke-width="1"
    />
    <!-- Shard 2: large upper-right -->
    <polygon
      data-depth="1"
      points="528,6 868,2 968,120 790,175 552,90"
      fill="url(#shardFill)" fill-opacity="0.055"
      stroke="#2a1416" stroke-width="1"
    />
    <!-- Shard 3: large lower-right -->
    <polygon
      data-depth="2"
      points="640,258 888,220 992,358 960,378 680,378"
      fill="url(#shardFill)" fill-opacity="0.075"
      stroke="#2a1416" stroke-width="1"
    />
    <!-- Shard 4: large lower-left -->
    <polygon
      data-depth="2"
      points="26,298 248,255 340,368 220,378 26,378"
      fill="url(#shardFill)" fill-opacity="0.065"
      stroke="#2a1416" stroke-width="1"
    />
    <!-- Shard 21: upper-far-right corner -->
    <polygon
      data-depth="2"
      points="890,2 1000,0 1000,82 924,100 872,44"
      fill="url(#shardFill)" fill-opacity="0.055"
      stroke="#2a1416" stroke-width="1"
