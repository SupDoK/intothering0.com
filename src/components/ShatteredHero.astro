    />
    <!-- Shard 16: tiny center-right fragment -->
    <polygon
      data-depth="4"
      points="660,220 724,200 740,260 674,277"
      fill="url(#shardFill)" fill-opacity="0.28"
      stroke="rgba(200,225,248,0.65)" stroke-width="0.8"
    />
    <!-- Shard 13: tiny bottom-right -->
    <polygon
      data-depth="4"
      points="870,334 945,310 960,378 878,378"
      fill="url(#shardFill)" fill-opacity="0.20"
      stroke="rgba(200,225,248,0.5)" stroke-width="0.7"
    />
    <!-- Shard 18: small near-center upper -->
    <polygon
      data-depth="4"
      points="494,78 570,60 584,130 518,148"
      fill="url(#shardFill)" fill-opacity="0.26"
      stroke="rgba(200,225,248,0.65)" stroke-width="0.9"
    />
    <!-- Shard 19: tiny narrow center fragment — highest opacity, closest -->
    <polygon
      data-depth="4"
      points="488,158 570,138 580,192 500,210"
      fill="url(#shardFill)" fill-opacity="0.32"
      stroke="rgba(220,238,252,0.75)" stroke-width="1"
    />
  </svg>

  <!-- Title overlay (lower-left, in a sparse area of the composition) -->
  <div class="hero-overlay">
    <!-- TODO: Replace this with your preferred site title or handle -->
    <span class="hero-eyebrow">Into The Ring 0</span>
    <p class="hero-tagline">windows internals &nbsp;·&nbsp; maldev &nbsp;·&nbsp; security research</p>
  </div>
</section>

<script>
  const hero = document.getElementById('hero') as HTMLElement;
  if (!hero) throw new Error('hero not found');

  const shards = Array.from(
    hero.querySelectorAll<SVGPolygonElement>('polygon[data-depth]')
  );

  // Pre-compute centroid for each shard (for rotation pivot)
  const centers = shards.map(p => {
    const pts = p.points;
    let cx = 0, cy = 0;
    for (let i = 0; i < pts.numberOfItems; i++) {
      cx += pts.getItem(i).x;
      cy += pts.getItem(i).y;
    }
    return { x: cx / pts.numberOfItems, y: cy / pts.numberOfItems };
  });

  let targetX = 0, targetY = 0;
  let currentX = 0, currentY = 0;
  let rafId = 0;

  function lerp(a: number, b: number, t: number): number {
    return a + (b - a) * t;
  }

  function tick() {
    currentX = lerp(currentX, targetX, 0.055);
    currentY = lerp(currentY, targetY, 0.055);

    const dx = Math.abs(currentX - targetX);
    const dy = Math.abs(currentY - targetY);

    shards.forEach((shard, i) => {
      const depth = parseInt(shard.dataset.depth ?? '1', 10);
      const tx = currentX * depth * 5.5;
      const ty = currentY * depth * 3.5;
      const rot = currentX * depth * 0.55;
      const { x: cx, y: cy } = centers[i];
      shard.setAttribute(
        'transform',
        `translate(${tx} ${ty}) rotate(${rot} ${cx} ${cy})`
      );
    });

    // Keep ticking until we've settled (avoids idle GPU work)
    if (dx > 0.0005 || dy > 0.0005) {
      rafId = requestAnimationFrame(tick);
    } else {
      rafId = 0;
    }
  }

  function scheduleRaf() {
    if (!rafId) rafId = requestAnimationFrame(tick);
  }

  // Bail out entirely if user prefers reduced motion
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    hero.addEventListener('mousemove', e => {
      const r = hero.getBoundingClientRect();
      targetX = (e.clientX - r.left - r.width  / 2) / (r.width  / 2);
      targetY = (e.clientY - r.top  - r.height / 2) / (r.height / 2);
      scheduleRaf();
    });

    hero.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
      scheduleRaf();
    });
  }
</script>
